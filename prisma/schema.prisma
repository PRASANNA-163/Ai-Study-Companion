// AI Study Companion — Data Model
// Design notes (for your architecture doc):
// - Every ownership-bearing table carries userId (directly or via project->space->user)
//   so every query can filter by owner -> satisfies PRD §52 data isolation.
// - material_chunks stores the vector column as Unsupported("vector") because Prisma
//   doesn't have a native pgvector type yet; we enable the extension via raw SQL
//   in the migration (see prisma/migrations or db/enable_pgvector.sql).
// - ai_requests is the observability backbone: every LLM call anywhere in the app
//   should insert one row here. This is what powers Admin > AI Usage (PRD §63/§44).
// - activity_events is a generic event log (PRD §37/§38) so new event types don't
//   need schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  lastActiveAt DateTime @default(now())

  spaces         Space[]
  activityEvents ActivityEvent[]
  aiRequests     AiRequest[]
  learningContext LearningContext?
}

model Space {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  spaceId     String
  name        String
  description String?
  goal        String?
  createdAt   DateTime @default(now())

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  materials     Material[]
  concepts      Concept[]
  conversations Conversation[]
  quizzes       Quiz[]
  activityEvents ActivityEvent[]

  @@index([spaceId])
}

enum MaterialStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model Material {
  id          String         @id @default(uuid())
  projectId   String
  filename    String
  storagePath String
  status      MaterialStatus @default(QUEUED)
  errorMessage String?
  createdAt   DateTime       @default(now())
  processedAt DateTime?

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  MaterialChunk[]

  @@index([projectId])
  @@index([status])
}

model MaterialChunk {
  id         String                       @id @default(uuid())
  materialId String
  content    String
  pageNumber Int?
  embedding  Unsupported("vector(384)")? // 384 dims = all-MiniLM-L6-v2 (local, free — see lib/embeddings.ts)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model Concept {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  masteryPct  Float    @default(0)
  previousMasteryPct Float @default(0)
  updatedAt   DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quizQuestions  QuizQuestion[]

  @@index([projectId])
}

model Conversation {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  citedSources   Json?       // [{ materialId, filename, page }]
  isUnsupported  Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Quiz {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())
  completedAt DateTime?
  targetCount    Int?    // user-chosen question count, null = open-ended until they end it
  typePreference String? // "MCQ" | "OPEN_ENDED" | "FILL_BLANK" | "MIXED", set once at quiz start

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([projectId])
}

enum QuestionType {
  MCQ
  OPEN_ENDED
  FILL_BLANK
}

model QuizQuestion {
  id            String       @id @default(uuid())
  quizId        String
  conceptId     String
  type          QuestionType
  difficulty    Int          @default(1) // 1-5
  question      String
  options       Json?        // for MCQ: string[]
  correctAnswer String?
  userAnswer    String?
  isCorrect     Boolean?
  feedback      String?      // AI-generated feedback on the user's specific answer
  explanation   String?      // generated at question-creation time — the "why" behind the correct answer, shown on request
  answeredAt    DateTime?
  createdAt     DateTime     @default(now())

  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([conceptId])
}

model LearningContext {
  id        String   @id @default(uuid())
  userId    String   @unique
  goals     Json?    // string[]
  strengths Json?    // string[]
  weaknesses Json?   // string[]
  preferences Json?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  eventType String   // e.g. "MATERIAL_UPLOADED", "QUIZ_COMPLETED"
  metadata  Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([eventType])
}

// Observability + cost tracking backbone — every AI call logs one row here.
model AiRequest {
  id            String   @id @default(uuid())
  userId        String
  feature       String   // "tutor" | "quiz_generation" | "assessment_grading" | "eval"
  model         String
  latencyMs     Int
  inputTokens   Int?
  outputTokens  Int?
  costEstimate  Float?
  status        String   // "success" | "error" | "timeout"
  errorMessage  String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([feature])
  @@index([status])
}

// Simple background job queue — a table instead of Redis/BullMQ to keep the
// 3-day build lean, per the architecture trade-off documented in README.
enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(uuid())
  type        String    // "process_material"
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status])
  @@index([type])
}
