# Database (Supabase or Neon Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Supabase (used for Auth + file storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side only, never expose to client

# LLM Provider
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"

# Embeddings — Groq has no embeddings endpoint, and a second paid API key
# isn't worth it for a prototype. This project runs embeddings LOCALLY using
# @xenova/transformers (all-MiniLM-L6-v2), so no embedding API key is needed
# at all. See src/lib/embeddings.ts.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
